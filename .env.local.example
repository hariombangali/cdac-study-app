# Copy to .env.local and fill in. Get the values from:
#   Supabase dashboard -> your project -> Project Settings -> API Keys
#   (the Project URL is on the same page, or behind the Connect button)
#
# Either key generation works:
#   NEW    : publishable (sb_publishable_...) + secret (sb_secret_...)
#   LEGACY : anon (eyJ...)                    + service_role (eyJ...)
#            ^ deprecated at the end of 2026
#
# Run supabase/schema.sql in the SQL Editor BEFORE running npm run setup,
# otherwise the tables and the private storage bucket will not exist.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# public key — publishable (sb_publishable_...) or anon (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# secret key — secret (sb_secret_...) or service_role (eyJ...)
# Only used by the local upload/verify scripts. Never set this on Vercel.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key

# Optional: point the manifest scan at a different folder.
# MATERIAL_SOURCE_DIR=/Users/you/Downloads/suneam
